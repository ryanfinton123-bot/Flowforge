import { useEffect, useState } from 'react';
import { getStockQuote } from '@/lib/polygon';

type DarkPoolTrade = {
  symbol: string;
  price: number;
  size: number;
  amount: string;
  venue: string;
  time: string;
};

export default function DarkPoolTable() {
  const [trades, setTrades] = useState<DarkPoolTrade[]>([]);
  const [loading, setLoading] = useState(true);

  const symbols = ['NVDA', 'TSLA', 'AAPL', 'AMD', 'META'];

  useEffect(() => {
    const fetchDarkPool = async () => {
      const mockTrades: DarkPoolTrade[] = [];
      for (const sym of symbols) {
        try {
          await getStockQuote(sym); // just to check API works
          mockTrades.push({
            symbol: sym,
            price: Math.random() * 200 + 100,
            size: Math.floor(Math.random() * 50000) + 5000,
            amount: `$${(Math.random() * 15 + 2).toFixed(1)}M`,
            venue: ['Citadel', 'UBS ATS', 'Sigma X', 'JPM-X'][Math.floor(Math.random()*4)],
            time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
          });
        } catch (e) {}
      }
      setTrades(mockTrades.sort((a, b) => parseFloat(b.amount.slice(1)) - parseFloat(a.amount.slice(1))));
      setLoading(false);
    };

    fetchDarkPool();
    const interval = setInterval(fetchDarkPool, 20000);
    return () => clearInterval(interval);
  }, []);

  return (
    <div className="bg-zinc-900 rounded-3xl p-6">
      <h2 className="text-2xl font-semibold mb-6 flex items-center gap-3">
        🕳️ Dark Pool Prints
      </h2>
      <div className="space-y-3">
        {trades.map((trade, i) => (
          <div key={i} className="bg-zinc-950 border border-zinc-800 rounded-2xl p-5 flex justify-between items-center">
            <div>
              <span className="text-2xl font-bold">{trade.symbol}</span>
              <span className="ml-4 text-zinc-400">@ ${trade.price.toFixed(2)}</span>
            </div>
            <div className="text-right">
              <div className="font-bold text-xl">{trade.amount}</div>
              <div className="text-sm text-zinc-400">{trade.size.toLocaleString()} shares • {trade.venue}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  );'use client';
